# ---------------------------------------------------------------------------
# Sarh Al-Waleed backend configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# --- Database -------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/sarh_alwaleed
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/sarh_alwaleed?retryWrites=true&w=majority
MONGODB_URI=mongodb://USERNAME:PASSWORD@localhost:27017/DATABASE_NAME

# --- Authentication -------------------------------------------------------
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
COOKIE_NAME=sarh_admin_token

# --- CORS -----------------------------------------------------------------
# Leave empty when the API also serves the site (the default). Only set this
# if the frontend is hosted on a different origin.
# CORS_ORIGINS=https://your-domain.example,https://www.your-domain.example
CORS_ORIGINS=

# --- Uploads --------------------------------------------------------------
# Attachments contain national IDs and deeds. Keep this path outside any
# publicly served directory; the API serves it behind authentication.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
MAX_FILES_PER_FIELD=5

# --- Static site ----------------------------------------------------------
# Serve ../frontend from this process. Set to false if a CDN serves it.
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend

# --- Initial admin account ------------------------------------------------
# Optional defaults for `npm run create-admin`. There is NO built-in admin
# account: one must be created explicitly. Prefer passing --email/--password
# on the command line so no password is ever written to a file. If you do set
# them here, clear the values again once the account exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
